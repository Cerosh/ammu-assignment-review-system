# Copy this file to .env for local development. Loaded automatically via
# python-dotenv (see src/ammu_review/config.py).

# Required -- read automatically by ChatOpenAI.
OPENAI_API_KEY=

# Optional -- overrides the default model (see config.DEFAULT_MODEL_NAME).
# AMMU_MODEL_NAME=gpt-4o-mini

# Optional -- standard LangSmith tracing variables. If set, LangChain traces
# every run automatically; no code change is needed to enable/disable this.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ammu-assignment-review-system
