# Copy this file to .env for local development. Loaded automatically via
# python-dotenv (see src/ammu_review/config.py).
#
# This file must contain placeholders only -- never real credentials or
# access codes. Never commit .env itself (already in .gitignore).

# Required -- read automatically by ChatOpenAI.
OPENAI_API_KEY=

# Optional -- overrides the default model (see config.DEFAULT_MODEL_NAME).
# AMMU_MODEL_NAME=gpt-4o-mini

# Optional -- standard LangSmith tracing variables. If set, LangChain traces
# every run automatically; no code change is needed to enable/disable this.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ammu-assignment-review-system

# Required in any deployed environment -- the shared private-pilot access
# code students/testers must enter before reaching the app (see
# src/ammu_review/pilot_access.py). If unset, the app fails closed and
# blocks everyone rather than becoming accidentally public. Not required
# for local development unless you want to exercise the gate locally.
# AMMU_PILOT_ACCESS_CODE=

# Optional -- caps how many drafts/revisions can be submitted for review
# per assignment (see src/ammu_review/cost_guard.py), a simple guard
# against accidental runaway LLM usage. Defaults to 10, generous enough
# for genuine use (understand -> draft -> a few revisions -> optionally
# challenge). A non-positive or non-numeric value falls back to the
# default rather than disabling the guard.
# AMMU_MAX_DRAFTS_PER_ASSIGNMENT=10

# Optional -- where session/telemetry JSON files are written (see
# src/ammu_review/app/store.py and src/ammu_review/telemetry/store.py).
# Default to a path relative to the repo, fine for local development.
# In any deployed environment, set both explicitly to a path on a
# persistent volume -- see .ai/PRODUCTION_READINESS.md "Filesystem
# persistence": without a real mounted volume, this data does not survive
# a restart or redeploy.
# AMMU_SESSIONS_DIR=/data/sessions
# AMMU_TELEMETRY_DIR=/data/telemetry
