# Copy this file to .env for local development. Loaded automatically via
# python-dotenv (see src/ammu_review/config.py).
#
# This file must contain placeholders only -- never real credentials or
# access codes. Never commit .env itself (already in .gitignore).

# Required -- read automatically by ChatOpenAI.
OPENAI_API_KEY=

# Optional -- overrides the default model (see config.DEFAULT_MODEL_NAME).
# AMMU_MODEL_NAME=gpt-4o-mini

# Optional -- standard LangSmith tracing variables. If set, LangChain traces
# every run automatically; no code change is needed to enable/disable this.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ammu-assignment-review-system

# Required in any deployed environment -- the shared private-pilot access
# code students/testers must enter before reaching the app (see
# src/ammu_review/pilot_access.py). If unset, the app fails closed and
# blocks everyone rather than becoming accidentally public. Not required
# for local development unless you want to exercise the gate locally.
# AMMU_PILOT_ACCESS_CODE=
